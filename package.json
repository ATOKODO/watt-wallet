{
  "name": "watt-wallet",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "node scripts/prepare-dev-licenses.mjs",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "postbuild": "node scripts/prepare-licenses.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:offline": "node scripts/offline-smoke.mjs",
    "test:native": "node scripts/native-smoke.mjs",
    "format:check": "prettier --check src tests e2e scripts *.json *.ts docs/*.md README.md src-tauri/*.json src-tauri/capabilities/*.json .storybook visual",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --bundles nsis",
    "examples": "tsx scripts/examples.ts",
    "docs:dev": "node scripts/docs-assets.mjs && vitepress dev docs --host 127.0.0.1 --port 5173",
    "docs:build": "node scripts/docs-assets.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 4173",
    "test:docs": "node scripts/docs-smoke.mjs",
    "storybook": "storybook dev --host 127.0.0.1 -p 6007 --no-open",
    "storybook:build": "storybook build -o storybook-static",
    "test:storybook": "node scripts/storybook-smoke.mjs",
    "storybook:typecheck": "tsc --noEmit -p .storybook/tsconfig.json",
    "test:visual": "npm run build && npm run storybook:build && playwright test -c playwright.visual.config.ts",
    "test:visual:update": "npm run test:visual -- --update-snapshots=all",
    "test:visual:report": "playwright show-report playwright-report/visual",
    "visual:typecheck": "tsc --noEmit -p visual/tsconfig.json"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "fflate": "^0.8.2",
    "rxjs": "^7.8.2",
    "three": "0.186.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.2",
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-designs": "11.1.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/angular-vite": "10.6.4",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.0",
    "prettier": "^3.9.7",
    "storybook": "10.6.4",
    "tsx": "^4.21.0",
    "typescript": "~6.0.0",
    "vite": "8.3.5",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@angular/build": {
      "vite": "$vite"
    }
  }
}
