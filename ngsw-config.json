{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "application",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.css",
          "/*.js",
          "!/ngsw-worker.js",
          "!/safety-worker.js",
          "!/worker-basic.min.js",
          "/favicon.svg",
          "/manifest.webmanifest",
          "/fonts/**",
          "/LICENSE.txt",
          "/3rdpartylicenses.txt"
        ]
      }
    }
  ]
}
